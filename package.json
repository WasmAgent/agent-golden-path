{
  "name": "agent-golden-path",
  "version": "1.0.0",
  "description": "Golden-path reference app for the WasmAgent provable-agent stack: agent execution → tool admission → compliance verification → signed AEP evidence → audit report + trust passport, end to end.",
  "type": "commonjs",
  "main": "src/server.ts",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "cd web && npm run build",
    "ts-check": "tsc --noEmit",
    "web:install": "cd web && npm install",
    "web:dev": "cd web && npm run dev",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@openagentaudit/adapters": "^0.6.0",
    "@openagentaudit/core": "^0.7.0",
    "@openagentaudit/passport": "^0.6.1",
    "@openagentaudit/schema": "^0.6.0",
    "@wasmagent/a2a": "^1.0.10",
    "@wasmagent/aep": "^2.3.0",
    "@wasmagent/ag-ui": "^1.0.10",
    "@wasmagent/agentbom-core": "^0.4.0",
    "@wasmagent/compliance": "^3.1.0",
    "@wasmagent/core": "^3.3.0",
    "@wasmagent/mcp-firewall": "^2.0.2",
    "@wasmagent/otel-exporter": "^2.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "tsx": "^4.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
