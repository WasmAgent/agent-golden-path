{
  "name": "agent-golden-path",
  "version": "1.0.0",
  "description": "Golden-path reference app for the WasmAgent provable-agent stack: agent execution \u2192 tool admission \u2192 compliance verification \u2192 signed AEP evidence \u2192 audit report + trust passport, end to end.",
  "type": "commonjs",
  "main": "src/server.ts",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "cd web && bun run build",
    "ts-check": "tsc --noEmit",
    "web:install": "cd web && bun install",
    "web:dev": "cd web && bun run dev",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e:certified": "bun run ts-check && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@openagentaudit/adapters": "^0.7.0",
    "@openagentaudit/core": "^0.8.0",
    "@openagentaudit/passport": "^0.6.1",
    "@openagentaudit/schema": "^0.7.0",
    "@wasmagent/a2a": "^1.0.10",
    "@wasmagent/aep": "^2.9.0",
    "@wasmagent/ag-ui": "^1.0.10",
    "@wasmagent/agentbom-core": "^0.4.0",
    "@wasmagent/compliance": "^3.1.6",
    "@wasmagent/core": "^3.7.0",
    "@wasmagent/mcp-firewall": "^2.1.1",
    "@wasmagent/mcp-server": "^1.1.15",
    "@wasmagent/otel-exporter": "^2.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "tsx": "^4.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
