# ── LLM (Anthropic) ───────────────────────────────────────────────────────────
# Required for local dev. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default model (defaults to claude-sonnet-latest)
# LLM_MODEL=claude-sonnet-latest

# Optional: point at a compatible proxy / gateway
# ANTHROPIC_BASE_URL=

# ── Evidence signing (AEP) ────────────────────────────────────────────────────
# 64-char hex seed used to sign AEP evidence records. A default dev seed is used
# when unset; you MUST set a real one in production (the server refuses to start
# in production with the default seed).
# AEP_SIGNING_SEED=
# AEP_KEY_ID=golden-path-dev-key-01

# ── Optional integrations (all off by default) ────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=   # export chat spans over OTLP/HTTP
# A2A_ENABLED=                   # mount the A2A agent-to-agent server
# AG_UI_ENABLED=                 # mount the AG-UI SSE endpoint

# ── App behaviour ─────────────────────────────────────────────────────────────
# CHAT_TOOL_CALLS_MAX=12
# DEFAULT_USER_ID=demo_user
# PORT=4000
